# MTProto API credentials
# The configuration collector uses an unauthenticated MTProto connection,
# so only API ID and API hash are required for crawling.
TG_API_ID=
TG_API_HASH=

# Optional user StringSession for user-only server datasets (reactions/premium promo).
# Generate it with Telethon and keep it secret.
TG_USER_SESSION=

# Optional bot token reserved for the future Telegram alerting layer.
TG_BOT_TOKEN=

# Optional Telegram test-network credentials
TG_TEST_API_ID=
TG_TEST_API_HASH=

# Optional: test bot token for future bot-based collectors/alerts.
TG_TEST_BOT_TOKEN=

# Optional JSON map to override the built-in Telegram test DC endpoints.
# Example:
# {"1-test":["149.154.175.10",443],"2-test":["149.154.167.40",443]}
TDC_TEST_DC_ENDPOINTS=
