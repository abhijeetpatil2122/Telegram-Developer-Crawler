# MTProto API credentials
# The same application api_id/api_hash are used for production and
# Telegram's test DC network.
TG_API_ID=
TG_API_HASH=

# Optional user StringSession for user-only server datasets (reactions/premium promo).
# Generate it with Telethon and keep it secret.
TG_USER_SESSION=

# Bot token used by the Telegram notification layer.
TG_BOT_TOKEN=

# Telegram channel/chat where temporary crawl status and change alerts are posted.
TG_ALERT_CHAT_ID=

# Optional JSON map to override the built-in Telegram test DC endpoints.
# Example:
# {"1-test":["149.154.175.10",80],"2-test":["149.154.167.40",80],"3-test":["149.154.175.117",80]}
TDC_TEST_DC_ENDPOINTS=
