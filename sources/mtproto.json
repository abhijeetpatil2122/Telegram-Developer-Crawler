{
  "production_dcs": [
    "1",
    "2",
    "3",
    "4",
    "5"
  ],
  "test_dcs": [
    "1-test",
    "2-test",
    "3-test"
  ],
  "collectors": [
    "help.getConfig",
    "help.getCdnConfig",
    "help.getCountriesList",
    "help.getAppConfig",
    "messages.getAvailableReactions",
    "help.getPremiumPromo",
    "core.telegram.org/schema",
    "core.telegram.org/schema/json",
    "core.telegram.org/schema/mtproto",
    "core.telegram.org/schema/mtproto-json",
    "github.com/tdlib/td:td/generate/scheme/td_api.tl",
    "github.com/telegramdesktop/tdesktop:Telegram/SourceFiles/mtproto/scheme/api.tl",
    "github.com/telegramdesktop/tdesktop:Telegram/SourceFiles/mtproto/scheme/mtproto.tl",
    "telegram.org/dl/android/apk",
    "telegram.org/dl/android/apk-public-beta",
    "Telegram Android embedded org.telegram.tgnet TL schema"
  ],
  "scope": {
    "per_dc": [
      "help.getConfig",
      "help.getCountriesList",
      "help.getAppConfig"
    ],
    "global_bot": [
      "help.getCdnConfig"
    ],
    "global_user": [
      "messages.getAvailableReactions",
      "help.getPremiumPromo"
    ],
    "paths": {
      "config": "data/mtproto/configs/",
      "app_config": "data/mtproto/app-config/",
      "countries_list": "data/mtproto/countries-list/",
      "global": "data/mtproto/global/",
      "tl": "data/mtproto/tl/",
      "tdlib": "data/tdlib/tl/",
      "tdesktop": "data/tdesktop/tl/",
      "android": "data/TgAndroid/",
      "android_tl": "data/TgAndroid/tl/",
    },
    "tl_schema": [
      "core.telegram.org/schema",
      "core.telegram.org/schema/json",
      "core.telegram.org/schema/mtproto",
      "core.telegram.org/schema/mtproto-json"
    ],
    "tdlib_schema": {
      "repository": "https://github.com/tdlib/td",
      "path": "td/generate/scheme/td_api.tl",
      "raw": "https://raw.githubusercontent.com/tdlib/td/master/td/generate/scheme/td_api.tl"
    },
    "tdesktop_schema": {
      "repository": "https://github.com/telegramdesktop/tdesktop",
      "branch": "dev",
      "api_path": "Telegram/SourceFiles/mtproto/scheme/api.tl",
      "api_raw": "https://raw.githubusercontent.com/telegramdesktop/tdesktop/dev/Telegram/SourceFiles/mtproto/scheme/api.tl",
      "mtproto_path": "Telegram/SourceFiles/mtproto/scheme/mtproto.tl",
      "mtproto_raw": "https://raw.githubusercontent.com/telegramdesktop/tdesktop/dev/Telegram/SourceFiles/mtproto/scheme/mtproto.tl"
    },
    "android_client": {
      "stable_apk": "https://telegram.org/dl/android/apk",
      "beta_apk": "https://telegram.org/dl/android/apk-public-beta"
    }
  },
  "normalization": {
    "config": [
      "date",
      "expires",
      "dc_options",
      "autologin_token"
    ],
    "app_config": [
      "hash",
      "ton_usd_rate"
    ],
    "premium_promo": [
      "users",
      "status_text",
      "status_entities",
      "period_options"
    ],
    "tl_schema": [
      "line endings",
      "trailing whitespace",
      "JSON key ordering"
    ],
    "tdlib_schema": [
      "line endings",
      "trailing whitespace",
      "JSON key ordering"
    ],
    "tdesktop_schema": [
      "line endings",
      "trailing whitespace",
      "JSON key ordering"
    ],
    "android_client": [
      "APK SHA-256",
      "decoded manifest metadata",
      "strings.xml",
      "public.xml"
    ],
    "android_tl": [
      "line endings",
      "trailing whitespace",
      "definition ordering",
      "structured JSON key ordering"
    ],
    "change_reports": [
      "semantic additions",
      "semantic changes",
      "semantic deletions",
      "credited unified diff hunks"
    ]
  },
  "endpoint_discovery": {
    "production": "help.getConfig",
    "test": "built-in Telegram test DC endpoints; optional override: TDC_TEST_DC_ENDPOINTS",
    "tdlib": "official tdlib/td master branch",
    "tdesktop": "official telegramdesktop/tdesktop dev branch",
    "android_stable": "telegram.org/dl/android/apk",
    "android_beta": "telegram.org/dl/android/apk-public-beta",
    "android_tl": "Telegram Android APKs resolved by Module 5A"
  },
  "authentication": {
    "production_and_test": "TG_API_ID + TG_API_HASH",
    "global_bot": "TG_BOT_TOKEN",
    "tl_schema": "public HTTPS sources",
    "tdlib_schema": "public GitHub source",
    "tdesktop_schema": "public GitHub source",
    "android_client": "public HTTPS APK sources",
    "android_tl": "public HTTPS APK sources"
  },
  "safety": {
    "max_leaf_removal_ratio": 0.1,
    "tl_schema_max_definition_removal_ratio": 0.1,
    "tdlib_schema_max_definition_removal_ratio": 0.1,
    "tdesktop_schema_max_definition_removal_ratio": 0.1,
    "android_client": {
      "apktool_required": true,
      "required_resources": [
        "AndroidManifest.xml",
        "res/values/strings.xml",
        "res/values/public.xml"
      ],
      "apk_min_bytes": 1048576,
      "tl_extraction": {
        "target_package": "org.telegram.tgnet",
        "minimum_constructors": 500,
        "minimum_methods": 200,
        "max_definition_removal_ratio": 0.1,
        "apk_binaries_committed": false,
        "decompiled_sources_committed": false
      }
    }
  }
}
